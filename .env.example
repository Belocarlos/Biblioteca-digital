# Ligação da aplicação (papel ol4_app, sujeito a RLS)
DATABASE_URL=postgres://ol4_app:ALTERAR@localhost:5432/ol4
# Ligação do proprietário do esquema, usada apenas pelas migrações e scripts de manutenção
MIGRATION_DATABASE_URL=postgres://ol4_owner:ALTERAR@localhost:5432/ol4
# Palavra-passe atribuída ao papel ol4_app pelo script de migração
APP_DB_PASSWORD=ALTERAR

# Segredo com pelo menos 32 caracteres (resumos de IP e tokens de formulário)
# Gerar com: openssl rand -base64 48
APP_SECRET=ALTERAR

# Endereço público da plataforma, sem barra final.
# Nesta fase, o endereço temporário do ambiente de pré-visualização.
SITE_URL=http://localhost:3000
# Manter "false" no ambiente de testes para impedir a indexação
SITE_INDEXING=false

# Armazenamento de ficheiros: "local" ou "s3" (Supabase Storage, Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://<projeto>.supabase.co/storage/v1/s3
# S3_REGION=eu-west-1
# S3_BUCKET=biblioteca
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Chave estável para as Server Actions quando existem várias instâncias
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
